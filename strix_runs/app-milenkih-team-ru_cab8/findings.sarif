            {
              "id": "strix-coverage/api1-bola-bfla-writing-or-deleting-moderator-authored-feed-content",
              "name": "API1 BOLA/BFLA — writing or deleting moderator-authored feed content",
              "shortDescription": {
                "text": "Coverage: API1 BOLA/BFLA — writing or deleting moderator-authored feed content"
              },
              "fullDescription": {
                "text": "Coverage of API1 BOLA/BFLA — writing or deleting moderator-authored feed content across the assessed attack surface."
              },
              "defaultConfiguration": {
                "level": "none"

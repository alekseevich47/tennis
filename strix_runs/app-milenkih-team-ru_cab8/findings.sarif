              "risk_area": "Stored XSS via self-editable unvalidated avatar_url",
              "surface": "users.avatar_url (self-editable field → &lt;img src&gt; sink)",
              "recorded_by": "Achievements & Score Forgery Hunter",
              "source": "agent_reported"
            }
          }

                    "text": "MAX_BOT_TOKEN=f9LHodD0cOJDcZ1AhjMzhpcQOULnrqDkScxVEsSFGrLFdBhUhcW8tqgSWO4gl5Ri54GH6OUt-v_kiSFV-PMs=="
                  }
                }
              },
              "message": {
                "text": "Remove the production bot token from the client environment file (secret is server-side only)"
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {

# === RATE LIMITING (защита от спама/брута) ===
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=map:10m rate=30r/s;

# === UPSTREAMS (keepalive для производительности) ===
upstream pocketbase {
    server 192.168.1.170:8090;
    keepalive 32;
}

upstream mapserver {
    server 192.168.1.172:8080;
    keepalive 16;
}

upstream pocketbase_tt {
    server 192.168.1.170:8091;
    keepalive 32;
}

upstream tt_backend {
    server 127.0.0.1:4000;
    keepalive 32;
}

upstream pocketbase_calc {
    server 127.0.0.1:8095;
    keepalive 32;
}

server {
    server_name urban42.online www.urban42.online api.urban42.online;
    listen 443 ssl http2; # http2 для скорости
    
    # SSL (Certbot)
    ssl_certificate /etc/letsencrypt/live/urban42.online-0001/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/urban42.online-0001/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # === БЕЗОПАСНОСТЬ ===
    #add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection "1; mode=block" always;

location /smile {
    alias /var/www/estetic_smile;
    index index.html;
    try_files $uri $uri/ /smile/index.html =404;
}

	# Перехватываем запросы к файлам основного PocketBase для кэширования
	location ^~ /api/files/ {
	    proxy_pass http://pocketbase/api/files/;
	    proxy_http_version 1.1;
	    proxy_set_header Host $host;
	    proxy_set_header X-Real-IP $remote_addr;
	    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	    proxy_set_header X-Forwarded-Proto $scheme;
	    
	    # Используем ту же зону кэша pb_tt_files или создайте новую
	    proxy_cache pb_tt_files; 
	    proxy_cache_valid 200 7d;
	    proxy_cache_use_stale error timeout updating;
	    proxy_cache_lock on;
	    proxy_cache_key "$scheme$host$request_uri";
	    
	    add_header X-Cache-Status $upstream_cache_status;
	    add_header Cache-Control "public, max-age=604800, immutable";
	}

    # === 1. PocketBase API ===
    location /api/ {
        limit_req zone=api burst=50 nodelay; # Rate limit
        
        proxy_pass http://pocketbase;
        proxy_http_version 1.1;
        
        # WebSocket для Realtime
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Проксирование заголовков
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Таймауты для загрузки фото/галереи
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 100M; # Макс. размер файла
    }

    # === 2. PocketBase Admin UI ===
    location /_/ {
        proxy_pass http://pocketbase;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Админку тоже защищаем рейт-лимитом
        limit_req zone=api burst=50 nodelay;
    }

	location ^~ /tt/api/files/ {
	    proxy_ignore_headers Cache-Control Expires Set-Cookie;
	    proxy_hide_header Set-Cookie;
	    proxy_pass http://pocketbase_tt/api/files/;
	    proxy_http_version 1.1;
	    proxy_set_header Host $host;
	    proxy_set_header X-Real-IP $remote_addr;
	    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	    proxy_set_header X-Forwarded-Proto $scheme;
	    proxy_cache pb_tt_files;
	    proxy_cache_valid 200 7d;
	    proxy_cache_use_stale error timeout updating;
	    proxy_cache_lock on;
	    proxy_cache_key "$scheme$host$request_uri";
	    add_header X-Cache-Status $upstream_cache_status;
	    add_header Cache-Control "public, max-age=604800, immutable";
}

    # === 4. PocketBase TT Bot API ===
    location /tt/api/ {
        proxy_pass http://pocketbase_tt/api/; # /api/ Слэш в конце важен
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
	client_max_body_size 100M;
    }

    # === 5. PocketBase TT Admin UI ===
    location /tt/_/ {
        proxy_pass http://pocketbase_tt/_/; # Слэш в конце важен
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

	location = /tt-api/sw.js {
	        alias /home/sa/tt_bot/client/dist/sw.js;
	        add_header Service-Worker-Allowed "/" always;
	        add_header Cache-Control "no-cache" always;
	    }
    # === 6. Фронтенд (Mini App) ===
    location /tt-api/ {
        alias /home/sa/tt_bot/client/dist/;
        index index.html;
        # Важно: добавляем префикс пути к index.html для корректной работы alias
        try_files $uri $uri/ /tt-api/index.html; 
        
        # Добавляем кэширование статики (картинки, скрипты)
        location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
            expires 1y;
            add_header Cache-Control "public, no-transform";
        }
    }

    # === 3. Map Tiles (OSM Vector) ===
    location /map/ {
        limit_req zone=map burst=50 nodelay;
        
        proxy_pass http://mapserver/; # Обрати внимание на / в конце
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        
        # === КЭШИРОВАНИЕ ТАЙЛОВ (критично для скорости карты!) ===
        proxy_cache_valid 200 1d; # Кэшировать успешные ответы на 24 часа
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header Cache-Control "public, max-age=86400, immutable";
        add_header X-Cache-Status $upstream_cache_status; # Для отладки
        
        # Если используешь proxy_cache, раскомментируй:
        proxy_cache map_cache;
        proxy_cache_key "$scheme$request_method$host$request_uri";
    }

    # === Health Check (для мониторинга) ===
    location /health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

# === 9. Фронтенд Калькулятора ===
location = /calc {
    return 301 /calc/;
}

    # SW / HTML / manifest — без долгого кэша (иначе телефон год держит старый SW)
    location = /calc/sw.js {
        alias /var/www/calc/dist/sw.js;
        add_header Cache-Control "no-cache" always;
    }
    location = /calc/index.html {
        alias /var/www/calc/dist/index.html;
        add_header Cache-Control "no-cache" always;
    }
    location = /calc/manifest.webmanifest {
        alias /var/www/calc/dist/manifest.webmanifest;
        add_header Cache-Control "no-cache" always;
        default_type application/manifest+json;
    }
    location ~* ^/calc/(workbox-[^/]+\.js)$ {
        alias /var/www/calc/dist/$1;
        add_header Cache-Control "no-cache" always;
    }

    location /calc/ {
        alias /var/www/calc/dist/;
        index index.html;
        try_files $uri $uri/ /calc/index.html;

        location ~* \.html$ {
            add_header Cache-Control "no-cache" always;
        }

        location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
            expires 1y;
            add_header Cache-Control "public, no-transform";
        }
    }

 # === 7. PocketBase Calc API ===
    location /calc/api/ {
        proxy_pass http://pocketbase_calc/api/; # Слэш в конце критически важен!
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 100M;
    }

    # === 8. PocketBase Calc Admin UI ===
    location /calc/_/ {
        proxy_pass http://pocketbase_calc/_/; # Слэш в конце критически важен!
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# === HTTP → HTTPS Redirect (чистый вариант) ===
server {
    if ($host = www.urban42.online) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = urban42.online) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = api.urban42.online) {
	return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name urban42.online www.urban42.online api.urban42.online;
    
    # Let's Encrypt challenge (не ломать авто-обновление сертификатов)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    
    # Всё остальное редиректим на HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name pass.urban42.online;

    # Пути к вашему текущему SSL-сертификату
    ssl_certificate /etc/letsencrypt/live/pass.urban42.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pass.urban42.online/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 128M;

    # Проксирование всех запросов для поддомена pass в контейнер Bitwarden
    location / {
        proxy_pass https://127.0.0.1:8443;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        
        proxy_set_header Authorization $http_authorization;
        proxy_pass_header Authorization;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

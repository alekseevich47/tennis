# Скопировать в /opt/tennis/client/.env на сервере (не коммитить).
# Без этих строк Vite подставит fallback urban42 / старый стенд — логин MAX сломается.
#
# Только публичные VITE_* для сборки клиента.
# MAX_BOT_TOKEN / TG_BOT_TOKEN / TG_BOT_WEBHOOK_SECRET — только в systemd override PocketBase
# (см. config/pocketbase.service и docs/ops-max-bot-token.md), никогда в client/.env и никогда в git.
VITE_POCKETBASE_URL=https://app.milenkih-team.ru
VITE_API_URL=https://app.milenkih-team.ru
VITE_MAX_AUTH_URL=https://app.milenkih-team.ru/api/max-auth
VITE_MAX_APP_ID=id420550689204_bot
VITE_MAX_SELLER_URL=https://max.ru/u/f9LHodD0cOKkZw87t6_Jy_PkELAZf1_Ycj-oyk_dnoGOBlY27GSpxl1YrZU
VITE_TG_AUTH_URL=https://app.milenkih-team.ru/api/tg-auth

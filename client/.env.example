# Локальные переменные Vite / MAX (не коммитить client/.env).
# Скопируйте в client/.env и заполните значения.

VITE_POCKETBASE_URL=
VITE_API_URL=
VITE_MAX_AUTH_URL=
VITE_MAX_APP_ID=
VITE_MAX_SELLER_URL=

# MAX_BOT_TOKEN сюда НЕ класть.
# Секрет читается только сервером PocketBase ($os.getenv) из systemd override:
#   /etc/systemd/system/pocketbase.service.d/override.conf
# Локально для hooks: переменная окружения процесса PocketBase, не client/.env.

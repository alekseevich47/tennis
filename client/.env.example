# Локальные переменные Vite / MAX / Telegram (не коммитить client/.env).
# Скопируйте в client/.env и заполните значения.

VITE_POCKETBASE_URL=
VITE_API_URL=
VITE_MAX_AUTH_URL=
VITE_MAX_APP_ID=
VITE_MAX_SELLER_URL=
VITE_TG_AUTH_URL=
# Опционально: чат продавца в Telegram (только https://t.me/…). Пусто → в TG Mini App откроется MAX-ссылка через openLink.
VITE_TG_SELLER_URL=

# MAX_BOT_TOKEN / TG_BOT_TOKEN сюда НЕ класть.
# Секреты читает только сервер PocketBase ($os.getenv) из systemd override:
#   /etc/systemd/system/pocketbase.service.d/override.conf
# Локально для hooks: переменная окружения процесса PocketBase, не client/.env.
